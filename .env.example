# Local environment for the k3d cluster. Copy to .env.local (gitignored) — or run
# scripts/gen-env.sh, which fills every generated secret with random values.
# scripts/secrets-apply.sh loads .env.local into the Kubernetes Secret `urumi-env`
# (namespace `urumi`). Format: KEY=VALUE, one per line, no quotes, no spaces around `=`.
# The values below are placeholders only. Never commit real values.

# WordPress admin login for the store (http://store.localtest.me/wp-admin).
WP_ADMIN_USER=admin
# WordPress admin password (generated).
WP_ADMIN_PASSWORD=change-me
# WordPress admin email; any address works locally.
WP_ADMIN_EMAIL=admin@store.localtest.me

# MariaDB root password for the store database (generated).
MARIADB_ROOT_PASSWORD=change-me
# MariaDB password for the WordPress database user (generated).
MARIADB_PASSWORD=change-me

# Postgres password for the gateway database (generated).
POSTGRES_PASSWORD=change-me

# Key that encrypts upstream credentials at rest: 32 random bytes, base64 (generated).
# Generate by hand with: openssl rand -base64 32
GATEWAY_ENC_KEY=change-me
# Secret that signs dashboard session cookies (generated).
GATEWAY_SESSION_SECRET=change-me
# Shared secret the gateway presents to the internal woo-mcp server (generated).
WOO_MCP_SHARED_SECRET=change-me

# First admin account created in the gateway on an empty database.
SEED_ADMIN_EMAIL=admin@app.localtest.me
# Password for the seeded admin (generated).
SEED_ADMIN_PASSWORD=change-me

# Claude API key for the dashboard chat agent. Fill in by hand.
ANTHROPIC_API_KEY=
# GitLab personal access token for the GitLab MCP upstream. Fill in by hand.
GITLAB_MCP_TOKEN=
